# Copy to .env (docker compose reads it automatically). NEVER commit .env.
#
# Generate secrets:
#   JWT_SECRET      : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   ENCRYPTION_KEY  : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing ENCRYPTION_KEY makes stored vendor bank account numbers unreadable. Back it up separately from the database.
JWT_SECRET=
ENCRYPTION_KEY=

# Optional: Google sign-in for EXISTING users only (needs an OAuth client ID from Google Cloud Console). Leave empty to disable.
GOOGLE_CLIENT_ID=

# Optional: email for invitations and approval notifications. Without it, notifications stay in-app and are marked "undelivered".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: OCR for photographed invoices (PNG/JPEG). Needs the optional tesseract.js package and internet access on first use.
OCR_ENABLED=0

# Development seed only (npm run seed). Must be a strong password. Never used in production.
SEED_PASSWORD=
