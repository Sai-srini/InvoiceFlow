{
  "name": "invoice-platform-server",
  "version": "1.0.0",
  "description": "Invoice & Vendor Payment Management Platform - Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/tests/integration/*.test.ts",
    "bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "seed": "tsx src/scripts/seed-dev.ts",
    "seed:demo": "tsx src/scripts/seed-demo-flow.ts",
    "extraction:accuracy": "tsx src/scripts/extraction-accuracy.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "google-auth-library": "11.3.0",
    "helmet": "8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.2",
    "pdfjs-dist": "^3.11.174",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "optionalDependencies": {
    "tesseract.js": "^7.0.0"
  }
}
